# ============================================================
# Registry configuration
# Copy this file to .env and fill in your values.
# ============================================================

# Docker image registry prefix (include trailing slash)
# Leave empty for public Docker Hub (local dev)
# Example for a mirror proxy:
#   REGISTRY_PREFIX=docker-proxy.local/mirror.gcr.io/
# Example for a separate quay.io mirror:
#   KEYCLOAK_REGISTRY_PREFIX=docker-proxy.local/quay.io/
REGISTRY_PREFIX=
KEYCLOAK_REGISTRY_PREFIX=

# Nexus PyPI proxy URL (used by pip in backend build)
# Example: https://nexus.corp.local/repository/pypi-proxy/simple
NEXUS_PYPI_URL=

# Nexus npm registry URL (used by npm in frontend build)
# Example: https://nexus.corp.local/repository/npm-proxy
NEXUS_NPM_URL=
