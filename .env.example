# ============================================================
# Proxy configuration
# Copy this file to .env and fill in your proxy URL.
# Leave blank to disable proxy.
# ============================================================

# HTTP/HTTPS proxy used by Docker build (pip, npm, apt) and running containers
# Example: http://proxy.corp.local:8080
HTTP_PROXY=
HTTPS_PROXY=

# Comma-separated list of hosts that should bypass the proxy
# Example: localhost,127.0.0.1,keycloak,backend,frontend
NO_PROXY=localhost,127.0.0.1,host.docker.internal,keycloak,backend,frontend
